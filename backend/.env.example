# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/smart-electronic-vehicle-charging-management-system

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Simulation
CHARGING_TICK_MS=2000

# This server's own public base URL (used to build the OAuth callback URLs
# Google/GitHub redirect back to — must match what you register with them)
API_BASE_URL=http://localhost:5000

# OAuth — Sign in with Google / GitHub (optional; login/register still work
# without these, the buttons will just show a helpful error until set).
# See docs/SETUP.md "OAuth setup" for how to create these credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
